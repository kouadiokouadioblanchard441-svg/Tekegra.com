{
  "version": 2,
  "buildCommand": "pnpm install && pnpm --filter @workspace/admin-panel run build && cp -r artifacts/admin-panel/dist/public public",
  "outputDirectory": "public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@5"
    },
    "api/bot.py": {
      "maxDuration": 30
    },
    "api/setup.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/webhook", "destination": "/api/bot" },
    { "source": "/setup",   "destination": "/api/setup" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|webhook|setup).*)", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
