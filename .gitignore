# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# The standalone Plesk package commits its production bundles so that
# GitHub -> Plesk "Pull + Deploy Now" can restart without a separate build hook.
!/plesk-deployment/
!/plesk-deployment/client-dist/
!/plesk-deployment/client-dist/**
!/plesk-deployment/server/
!/plesk-deployment/server/dist/
!/plesk-deployment/server/dist/**

# dependencies
node_modules

# Environment files and secrets
**/.env
**/.env.*
!**/.env.example

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
