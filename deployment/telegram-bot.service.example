[Unit]
Description=Lucky Jet Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This service runs on the SAME VPS that hosts Plesk.
# Replace telegrambot with the Plesk subscription system user if needed.
User=telegrambot
Group=telegrambot
WorkingDirectory=/voltatrucks.online/plesk-deployment/telegram-bot
EnvironmentFile=/voltatrucks.online/plesk-deployment/telegram-bot/.env
ExecStart=/voltatrucks.online/plesk-deployment/telegram-bot/start.sh
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target