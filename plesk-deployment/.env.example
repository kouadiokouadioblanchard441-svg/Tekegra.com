# Production Node.js server
NODE_ENV=production
PORT=3000

# PostgreSQL. Use the Plesk database host, or your Supabase connection URL.
DATABASE_URL=postgresql://user:password@host:5432/database
# Set DB_SSL=true for managed PostgreSQL providers that require TLS.
DB_SSL=false

# JWT signing secret. Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_a_long_random_secret

# Public URL and optional comma-separated CORS origins.
DOMAIN_URL=https://example.com
CORS_ORIGINS=https://example.com

# Telegram integration
BOT_TOKEN=replace_with_telegram_bot_token
ADMIN_ID=123456789
BOT_NAME=Lucky Jet AI Bot
BOT_PROMO_CODE=JRYVES
BOT_AFFILIATE_LINK=https://1win.com
FREE_SIGNALS_PER_DAY=6
PREMIUM_SIGNALS_PER_DAY=9
CHANNEL_1_ID=
CHANNEL_1_LINK=
CHANNEL_1_NAME=📢 Canal Officiel
CHANNEL_2_ID=
CHANNEL_2_LINK=
CHANNEL_2_NAME=📢 Canal Signaux VIP

# Optional external integrations reserved for future features.
OPENAI_API_KEY=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=