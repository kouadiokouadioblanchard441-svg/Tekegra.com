# Production Node.js server
NODE_ENV=production
# Plesk fournit normalement PORT automatiquement. Laisser cette valeur gérée
# par Plesk si le panneau impose un port dynamique.
PORT=3000

# PostgreSQL. Use either DATABASE_URL or SUPABASE_DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/database
SUPABASE_DATABASE_URL=
# Set DB_SSL=true for managed PostgreSQL providers that require TLS.
DB_SSL=false
DB_POOL_MAX=10

# JWT signing secret. Generate with: openssl rand -base64 48
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_TTL=8h

# Public URL and optional comma-separated CORS origins.
DOMAIN_URL=https://example.com
CORS_ORIGINS=https://example.com
LOG_LEVEL=info

# Telegram token used by the Node admin broadcast endpoint.
BOT_TOKEN=replace_with_telegram_bot_token

# Optional external integrations reserved for future features.
OPENAI_API_KEY=
GEMINI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=